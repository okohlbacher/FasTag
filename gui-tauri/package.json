{
  "name": "fastag-gui",
  "private": true,
  "version": "0.19.0",
  "description": "Cross-platform desktop GUI for the FasTag mass-spectrometry sequence tagger (Tauri)",
  "author": "Oliver Kohlbacher and contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "params": "node scripts/gen-params.mjs src-tauri/resources/fastag/bin/FasTag > src/params.generated.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
